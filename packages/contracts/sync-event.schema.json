{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mtandao Sync Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "site_id",
    "device_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "router_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string",
      "maxLength": 200
    }
  }
}
