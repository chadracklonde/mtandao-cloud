# Never commit real credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
PORT=3001
# Payments (server-side secrets, never expose to a browser or mobile client)
SUPABASE_SERVICE_ROLE_KEY=
# Sandbox provider only: leave empty in production
PAYMENT_SANDBOX_WEBHOOK_SECRET=
# Number of trusted reverse proxies in front of the API (1 on Render / Cloud Run, 0 if exposed directly)
TRUST_PROXY_HOPS=0
